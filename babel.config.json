{
    "sourceType": "unambiguous",
    "presets": [
        "@babel/preset-env",
        ["@babel/preset-react", {
            "runtime": "automatic",
            "developmentSourceSelf": true
        }]
    ],
    "plugins": [
        "@babel/plugin-transform-class-properties",
        "@babel/plugin-transform-runtime"
    ]
}
